generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         String   @default("OWNER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  plan               String              @default("START") // START | BUSINESS | CHAIN
  subscriptionStatus String              @default("active") // active | trial | past_due | canceled
  subscriptionExpiresAt DateTime?
  venues             Venue[]
  telegramAccounts   TelegramAccount[]
  telegramAuthTokens TelegramAuthToken[]
  payments           PaymentOrder[]
}

model Venue {
  id                     String              @id @default(cuid())
  name                   String
  address                String?
  dateToleranceDays      Int                 @default(1)
  amountTolerancePercent Float               @default(5.0)
  fuzzyMatchThreshold    Float               @default(0.7)
  iikoApiKey             String?
  iikoOrgId              String?
  iikoAutoSync           Boolean             @default(false)
  iikoLastSyncAt         DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  ownerId                String?
  owner                  User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  transactions           Transaction[]
  deduplicationPairs     DeduplicationPair[]
  fileUploads            FileUpload[]
  inventoryItems         InventoryItem[]
  cashBalances           CashBalance[]
  balanceSnapshots       BalanceSnapshot[]
  telegramAccounts       TelegramAccount[]
  receiptScans           ReceiptScan[]
  bankConnections        BankConnection[]
  menuItems              MenuItem[]
}

model Transaction {
  id             String              @id @default(cuid())
  venueId        String
  venue          Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  source         String              // iiko | bank | admin | manual
  date           DateTime
  amount         Float
  type           String              // income | expense
  category       String              // food | bar | salary | rent | utilities | marketing | other
  counterparty   String
  description    String
  status         String              @default("unique") // unique | duplicate | pending_review
  duplicateOfId  String?
  originalFileId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  leftPairs      DeduplicationPair[] @relation("LeftTransaction")
  rightPairs     DeduplicationPair[] @relation("RightTransaction")
  receiptScan    ReceiptScan?

  @@index([venueId, date])
  @@index([venueId, status])
}

model DeduplicationPair {
  id               String      @id @default(cuid())
  venueId          String
  venue            Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  leftTxId         String
  leftTransaction  Transaction @relation("LeftTransaction", fields: [leftTxId], references: [id], onDelete: Cascade)
  rightTxId        String
  rightTransaction Transaction @relation("RightTransaction", fields: [rightTxId], references: [id], onDelete: Cascade)
  matchScore       Int
  matchReasons     String[]
  status           String      @default("pending") // pending | merged | skipped
  resolvedAt       DateTime?
  createdAt        DateTime    @default(now())

  @@index([venueId, status])
}

model FileUpload {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  source       String
  fileName     String
  fileSize     Int
  rowCount     Int
  status       String   // processing | completed | error
  errorMessage String?
  uploadedAt   DateTime @default(now())

  @@index([venueId])
}

model InventoryItem {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  period       String   @default("2026-11")
  category     String
  name         String
  unit         String
  expectedQty  Float
  actualQty    Float
  pricePerUnit Float
  createdAt    DateTime @default(now())

  @@index([venueId, period])
}

model CashBalance {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  monthKey     String   // e.g. "2025-01"
  amount       Float
  bankBalance  Float?
  safeBalance  Float?
  shiftBalance Float?
  updatedAt    DateTime @updatedAt

  @@unique([venueId, monthKey])
}

model BalanceSnapshot {
  id                 String   @id @default(cuid())
  venueId            String
  venue              Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  monthKey           String   // e.g. "2026-11"

  cashAmount         Float    @default(0)
  inventoryFood      Float    @default(0)
  inventoryBar       Float    @default(0)
  accountsReceivable Float    @default(0)

  accountsPayable    Float    @default(0)
  payrollPayable     Float    @default(0)
  taxesPayable       Float    @default(0)
  guestPrepayments   Float    @default(0)

  safetyReserveDays  Int      @default(10)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([venueId, monthKey])
  @@index([venueId])
}

model TelegramAccount {
  id            String            @id @default(cuid())
  telegramId    BigInt            @unique
  username      String?
  firstName     String?
  lastName      String?
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeVenueId String?
  venue         Venue?            @relation(fields: [activeVenueId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  receiptScans  ReceiptScan[]
  sessions      TelegramSession[]

  @@index([telegramId])
  @@index([userId])
}

model TelegramSession {
  id                String          @id @default(cuid())
  telegramAccountId String
  account           TelegramAccount @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
  key               String
  value             Json
  expiresAt         DateTime?

  @@unique([telegramAccountId, key])
}

model ReceiptScan {
  id                String          @id @default(cuid())
  telegramAccountId String
  account           TelegramAccount @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
  venueId           String
  venue             Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)

  sourceType        String          // "qr_54fz" | "vision_llm" | "manual_text"
  rawText           String?         @db.Text
  extractedAmount   Float
  extractedDate     DateTime
  extractedVendor   String?
  category          String          // "food" | "bar" | "household" | etc.
  confidence        Float           @default(1.0)

  status            String          @default("pending") // "pending" | "confirmed" | "rejected"
  transactionId     String?         @unique
  transaction       Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt         DateTime        @default(now())

  @@index([venueId, createdAt])
}

model TelegramAuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  pin       String?  @unique
  venueId   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([pin])
}

model BankConnection {
  id               String    @id @default(cuid())
  venueId          String
  venue            Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bankType         String    // "TBANK" | "TOCHKA"
  accountNumber    String?
  token            String
  refreshToken     String?
  clientId         String?
  clientSecret     String?
  isSandbox        Boolean   @default(true)
  status           String    @default("connected") // "connected" | "error" | "disconnected"
  lastSyncAt       DateTime?
  lastErrorMessage String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([venueId])
  @@index([status])
}

model MenuItem {
  id              String   @id @default(cuid())
  venueId         String
  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  period          String   @default("2026-11") // YYYY-MM
  name            String
  category        String   // "kitchen" | "bar" | "dessert" | "other"
  sellingPrice    Float
  standardCost    Float    // нормативная себестоимость (техкарта)
  actualCost      Float    // фактическая себестоимость
  salesVolume     Float    // количество проданных порций
  matrixCategory  String?  // "star" | "plowhorse" | "puzzle" | "dog"
  abcRevenue      String?  // "A" | "B" | "C"
  xyzStability    String?  // "X" | "Y" | "Z"
  foodCostPercent Float?
  margin          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([venueId, period])
  @@index([venueId, category])
}

model PaymentOrder {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String    // "START" | "BUSINESS" | "CHAIN"
  amount            Float
  currency          String    @default("RUB")
  paymentGateway    String    // "yookassa" | "cloudpayments"
  externalPaymentId String?   @unique
  status            String    @default("pending") // "pending" | "succeeded" | "canceled"
  confirmationUrl   String?
  createdAt         DateTime  @default(now())
  paidAt            DateTime?

  @@index([userId])
  @@index([status])
}
